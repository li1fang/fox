{
  "name": "fox",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的个人生活助手，当前以健身训练主持为第一条主线。",
  "license": "MIT",
  "engines": {"node": "22.x"},
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/li1fang/fox.git"
  },
  "bugs": {
    "url": "https://github.com/li1fang/fox/issues"
  },
  "homepage": "https://github.com/li1fang/fox#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:web": "npm run dev -w @fox/web-runtime -- --host 0.0.0.0 --port 5177",
    "dev:api": "npm run dev -w @fox/api",
    "build": "npm run build -w @fox/core && npm run build -w @fox/schemas && npm run build -w @fox/api && npm run build -w @fox/web-runtime",
    "typecheck": "npm run typecheck -w @fox/core && npm run typecheck -w @fox/schemas && npm run typecheck -w @fox/api && npm run typecheck -w @fox/web-runtime",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node scripts/test-scripts.mjs public",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "bootstrap": "node scripts/development-environment.mjs bootstrap",
    "doctor": "node scripts/development-environment.mjs doctor",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:candidate": "node scripts/verify.mjs candidate",
    "verify:public": "node scripts/verify.mjs public",
    "verify:private": "node scripts/verify.mjs private",
    "verify:repository": "node scripts/repository-checks.mjs",
    "verify:receipt": "node scripts/verify.mjs receipt",
    "verify:history": "node scripts/public-history-audit.mjs",
    "diagnose:phone-feedback": "node scripts/native-ui-diagnostic.mjs",
    "diagnose:phone-ui": "node scripts/native-ui-diagnostic.mjs",
    "diagnose:native-ui": "node scripts/native-ui-diagnostic.mjs --vision",
    "build:simulator": "node scripts/ipad.mjs build-simulator",
    "ipad:doctor": "node scripts/ipad.mjs doctor",
    "iphone:doctor": "node scripts/iphone.mjs doctor",
    "iphone:build": "node scripts/iphone.mjs build",
    "iphone:install": "node scripts/iphone.mjs install",
    "iphone:open": "node scripts/iphone.mjs open",
    "iphone:run": "node scripts/iphone.mjs run",
    "ipad:generate": "node scripts/ipad.mjs generate",
    "ipad:build": "node scripts/ipad.mjs build",
    "ipad:build:fox": "node scripts/ipad.mjs build fox",
    "ipad:build:say": "node scripts/ipad.mjs build say",
    "ipad:install": "node scripts/ipad.mjs install",
    "ipad:install:fox": "node scripts/ipad.mjs install fox",
    "ipad:install:say": "node scripts/ipad.mjs install say",
    "ipad:open": "node scripts/ipad.mjs open",
    "ipad:open:fox": "node scripts/ipad.mjs open fox",
    "ipad:open:say": "node scripts/ipad.mjs open say",
    "ipad:run": "node scripts/ipad.mjs run",
    "ipad:smoke": "node scripts/ipad.mjs smoke",
    "test:native": "node scripts/ipad.mjs test-core",
    "test:journal": "node scripts/test-journal.mjs",
    "test:native:all": "npm run test:native && npm run test:journal",
    "test:trial": "node scripts/trial-suite.mjs",
    "vision:replay": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun swift run --package-path apps/ipad/FoxTrainingCore --scratch-path .tmp/native-core-build fox-pose-replay",
    "vision:corpus": "node scripts/vision-corpus.mjs",
    "vision:check": "node scripts/vision-video-check.mjs",
    "vision:cycles": "node scripts/vision-cycle-check.mjs",
    "vision:pull": "node scripts/vision-diagnostics.mjs pull",
    "vision:import": "node scripts/vision-diagnostics.mjs import",
    "vision:batch": "node scripts/vision-batch.mjs",
    "vision:evidence": "node scripts/vision-evidence.mjs",
    "vision:video": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun swift run --package-path apps/ipad/FoxTrainingCore --scratch-path .tmp/native-core-build fox-video-replay",
    "ipad:vision:open": "node scripts/ipad.mjs open fox vision",
    "test:ipad:ui": "node scripts/ipad.mjs test-ui",
    "test:vision:controller": "FOX_IOS_UI_TEST=FoxAppTests/VisionControllerReplayTests node scripts/ipad.mjs test-ui",
    "test:vision:flow": "FOX_IOS_UI_TEST=FoxUITests/FoxVisionUITests/testPreparationSurvivesWalkingBackWithoutRebindButton,FoxUITests/FoxVisionUITests/testLostSubjectRebindPreservesCountOnIndependentVisionPage,FoxUITests/FoxVisionUITests/testBatchRouteStartsAndReportsMissingInput node scripts/ipad.mjs test-ui",
    "test:home": "FOX_IOS_UI_TEST=FoxAppTests node scripts/ipad.mjs test-ui",
    "design:review": "node scripts/design-review.mjs run",
    "say:ipad-run": "node scripts/ipad.mjs run say",
    "say:export-capture": "node scripts/fox-say-export-capture.mjs",
    "say:linux-asr": "node scripts/fox-say-linux-asr-runner.mjs",
    "say:mac-bridge": "node scripts/fox-say-mac-input-bridge.mjs",
    "say:handoff-smoke": "node scripts/fox-say-handoff-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
